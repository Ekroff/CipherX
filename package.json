{
  "name": "cipherx",
  "version": "1.0.0",
  "description": "CipherX – Cryptographic Bill of Materials & Remediation Engine",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "vercel-build": "cd packages/frontend && npm run build",
    "build:frontend:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-frontend.ps1",
    "dev": "docker compose up -d && npm run dev:services",
    "dev:services": "npm run dev --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "docker compose up -d && npm run test:integration --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "CipherX Team",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ekroff/CipherX.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0"
  }
}
